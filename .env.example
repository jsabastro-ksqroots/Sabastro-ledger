# Copy this file to .env and fill in the blanks. .env is git-ignored and must never be committed.

# --- Database -----------------------------------------------------------------
# Owner connection (used for migrations and the seed). With Docker Compose the defaults below work.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sabastro_ledger"
# Runtime connection for the app. The role `ledger_app` is created by the first migration with
# the password below; the app falls back to DATABASE_URL if this is unset (you will see a warning).
APP_DB_PASSWORD="change-me-ledger-app"
APP_DATABASE_URL="postgresql://ledger_app:change-me-ledger-app@localhost:5432/sabastro_ledger"
# Docker Compose reads these three (optional; defaults shown).
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="5432"

# --- App ----------------------------------------------------------------------
APP_URL="http://localhost:3005"
NODE_ENV="development"
# 32 random bytes as hex (64 hex characters). Encrypts the TOTP secrets at rest.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=""
# Issuer name shown in the authenticator app.
TOTP_ISSUER="Sabastro Ledger"
# Set to "true" ONLY when the app runs behind Caddy (Phase 7). Then the client IP is read from the
# X-Forwarded-For header for the audit log and the per-IP login throttle. Locally leave it "false".
TRUST_PROXY_HEADERS="false"

# --- First two users (read by `pnpm db:seed`; re-running the seed never overwrites a changed password) ---
SEED_OWNER_EMAIL="jose@example.com"
SEED_OWNER_NAME="Jose Sabastro"
SEED_OWNER_PASSWORD=""
SEED_FULL_EMAIL="jamin@providencelegacyadvisors.com"
SEED_FULL_NAME="Jamin Smith"
SEED_FULL_PASSWORD=""

# --- Historical import (Phase 2) ----------------------------------------------
# Folder holding the two private source workbooks named in DATA_SOURCES.md. Default: data/source
IMPORT_SOURCE_DIR=""

# --- Later phases (leave blank for now) ----------------------------------------
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
SPACES_KEY=""
SPACES_SECRET=""
SPACES_BUCKET=""
SPACES_REGION="nyc3"
SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
