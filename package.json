{
  "name": "sabastro-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Private general ledger and bookkeeping app for Sabastro Real Estate Investments LLC and Providence Legacy Advisors LLC",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run tests/core",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:wait": "tsx scripts/wait-for-db.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:embedded": "tsx scripts/embedded-db.ts",
    "setup": "pnpm install && pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm db:seed",
    "setup:nodocker": "pnpm install && tsx scripts/embedded-db.ts --setup",
    "dev:nodocker": "tsx scripts/embedded-db.ts --dev",
    "postinstall": "prisma generate",
    "db:recreate": "tsx scripts/recreate-db.ts",
    "e2e:install": "playwright install chromium",
    "user:set-password": "tsx scripts/set-password.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.2.6",
    "dotenv": "17.4.2",
    "lucide-react": "1.45.0",
    "next": "15.5.25",
    "otplib": "13.5.0",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.87.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
