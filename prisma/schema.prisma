// Sabastro Ledger schema. Phase 0: identity, sessions, audit log, organisation, chart, classes, tax years.
// Phase 1: transactions, transaction lines, notes, tax-year checklist, saved views.
// Phase 2: import runs and the allocation-model tables (models, immutable versions, targets) that hold the
//          archived 2020–2024 reference models; Phase 5 builds the live model system on the same tables.
// Receipts and statements arrive in later phases.
// See docs/DESIGN.md for the plain-English description and the database-level rules.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity, sessions, audit
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  FULL
  LIMITED
  VIEW_ONLY
}

enum Permission {
  VIEW_LEDGER
  UPLOAD_RECEIPTS
  REVIEW_CONFIRM
  EDIT_POSTED
  MANAGE_MODELS
  RUN_REPORTS
  EXPORT
  VIEW_SETTINGS
  MANAGE_USERS
  CLOSE_YEAR
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  displayName      String    @map("display_name")
  passwordHash     String    @map("password_hash")
  role             UserRole
  mfaSecretEnc     String?   @map("mfa_secret_enc")
  mfaEnrolledAt    DateTime? @map("mfa_enrolled_at") @db.Timestamptz(6)
  mfaLastTimeStep  Int?      @map("mfa_last_time_step")
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockoutCount     Int       @default(0) @map("lockout_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions   UserPermission[]
  recoveryCodes RecoveryCode[]
  sessions      Session[]
  auditEntries  AuditLog[]
  notes         Note[]
  savedViews    SavedView[]

  @@map("users")
}

model UserPermission {
  userId     String     @map("user_id") @db.Uuid
  permission Permission
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_permissions")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  userId        String    @map("user_id") @db.Uuid
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  ip            String?
  userAgent     String?   @map("user_agent")
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?   @map("revoke_reason")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginAttempt {
  id          BigInt   @id @default(autoincrement())
  email       String
  ip          String
  succeeded   Boolean
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)

  @@index([email, attemptedAt])
  @@index([ip, attemptedAt])
  @@map("login_attempts")
}

/// Append-only. The app role can only INSERT and SELECT; a trigger blocks UPDATE/DELETE for everyone.
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  at             DateTime @default(now()) @db.Timestamptz(6)
  userId         String?  @map("user_id") @db.Uuid
  sessionId      String?  @map("session_id") @db.Uuid
  action         String
  subjectType    String?  @map("subject_type")
  subjectId      String?  @map("subject_id")
  subjectLabel   String?  @map("subject_label")
  entityId       String?  @map("entity_id") @db.Uuid
  taxYearId      String?  @map("tax_year_id") @db.Uuid
  before         Json?
  after          Json?
  reason         String?
  isLockOverride Boolean  @default(false) @map("is_lock_override")
  ip             String?
  userAgent      String?  @map("user_agent")
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([userId, at])
  @@index([action, at])
  @@index([entityId, at])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Organisation and chart
// ---------------------------------------------------------------------------

enum TaxForm {
  FORM_1065
  SCHEDULE_C
  FORM_1120S
}

model Entity {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  legalName String?  @map("legal_name")
  taxForm   TaxForm  @map("tax_form")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bankAccounts     BankAccount[]
  classes          Class[]
  taxYears         TaxYear[]
  bridgeAsPayer    EntityBridgeRule[] @relation("bridge_payer")
  bridgeAsRecv     EntityBridgeRule[] @relation("bridge_receiver")
  transactions     Transaction[]
  lines            TransactionLine[]
  allocationModels AllocationModel[]

  @@map("entities")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  number      String      @unique
  name        String
  parentGroup String      @map("parent_group")
  type        AccountType
  subType     String      @map("sub_type")
  subType2    String      @map("sub_type_2")
  isActive    Boolean     @default(true) @map("is_active")
  source      String?
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  bankAccount   BankAccount?
  bridgeAsPayer EntityBridgeRule[] @relation("bridge_payer_account")
  bridgeAsRecv  EntityBridgeRule[] @relation("bridge_receiver_account")
  lines         TransactionLine[]

  @@map("accounts")
}

enum BankAccountKind {
  CHECKING
  SAVINGS
  CASH_APP
}

model BankAccount {
  id          String          @id @default(uuid()) @db.Uuid
  entityId    String          @map("entity_id") @db.Uuid
  accountId   String          @unique @map("account_id") @db.Uuid
  name        String
  institution String?
  kind        BankAccountKind @default(CHECKING)
  last4       String?
  openedOn    DateTime?       @map("opened_on") @db.Date
  closedOn    DateTime?       @map("closed_on") @db.Date
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  transactions Transaction[]

  @@index([entityId])
  @@map("bank_accounts")
}

enum ClassKind {
  GENERAL
  RENTAL
  LAND
  FLIP
  BUSINESS
}

model Class {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @unique
  entityId        String    @map("entity_id") @db.Uuid
  isShared        Boolean   @default(false) @map("is_shared")
  isLegalEntity   Boolean   @default(false) @map("is_legal_entity")
  legalEntityName String?   @map("legal_entity_name")
  kind            ClassKind
  yearsNote       String?   @map("years_note")
  note            String?
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  entity            Entity             @relation(fields: [entityId], references: [id], onDelete: Restrict)
  lines             TransactionLine[]
  allocationTargets AllocationTarget[]

  @@index([entityId])
  @@map("classes")
}

enum BridgeMode {
  DISTRIBUTION_CONTRIBUTION
  INTERCOMPANY
}

/// How a payment by one entity's bank for another entity's class is bridged so each entity balances.
model EntityBridgeRule {
  id                String     @id @default(uuid()) @db.Uuid
  payerEntityId     String     @map("payer_entity_id") @db.Uuid
  receiverEntityId  String     @map("receiver_entity_id") @db.Uuid
  mode              BridgeMode @default(DISTRIBUTION_CONTRIBUTION)
  payerAccountId    String     @map("payer_account_id") @db.Uuid
  receiverAccountId String     @map("receiver_account_id") @db.Uuid
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  payerEntity     Entity  @relation("bridge_payer", fields: [payerEntityId], references: [id], onDelete: Restrict)
  receiverEntity  Entity  @relation("bridge_receiver", fields: [receiverEntityId], references: [id], onDelete: Restrict)
  payerAccount    Account @relation("bridge_payer_account", fields: [payerAccountId], references: [id], onDelete: Restrict)
  receiverAccount Account @relation("bridge_receiver_account", fields: [receiverAccountId], references: [id], onDelete: Restrict)

  @@unique([payerEntityId, receiverEntityId])
  @@map("entity_bridge_rules")
}

enum TaxYearState {
  OPEN
  CLOSED
  FILED
}

model TaxYear {
  id            String       @id @default(uuid()) @db.Uuid
  entityId      String       @map("entity_id") @db.Uuid
  year          Int
  state         TaxYearState @default(OPEN)
  closedAt      DateTime?    @map("closed_at") @db.Timestamptz(6)
  closedById    String?      @map("closed_by_id") @db.Uuid
  filedAt       DateTime?    @map("filed_at") @db.Timestamptz(6)
  filedById     String?      @map("filed_by_id") @db.Uuid
  overrideCount Int          @default(0) @map("override_count")
  note          String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  entity           Entity                 @relation(fields: [entityId], references: [id], onDelete: Restrict)
  checklist        TaxYearChecklistItem[]
  allocationModels AllocationModel[]

  @@unique([entityId, year])
  @@map("tax_years")
}

/// Key/value settings. scope = "GLOBAL" or an entity id.
model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String   @default("GLOBAL")
  key         String
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@map("settings")
}

// ---------------------------------------------------------------------------
// Ledger (Phase 1) — see docs/DESIGN.md §1 "Ledger", §2–§4
// ---------------------------------------------------------------------------

enum TransactionStatus {
  DRAFT
  FLAGGED
  POSTED
  VOIDED
}

enum TransactionKind {
  BANK
  JOURNAL
  ADJUSTING
}

enum TransactionSource {
  IMPORT
  RECEIPT
  STATEMENT
  MANUAL
}

enum ClassificationSource {
  IMPORT
  VENDOR_HISTORY
  AI
  HUMAN
}

/// One journal entry. Never deleted: the app role has no DELETE grant; wrong entries are VOIDED with a reason.
/// Database rules (hand-written SQL in the migration): per-entity balance over live lines, at least two live
/// lines unless voided, complete lines when posted, void/posted field requirements, the tax-year lock.
model Transaction {
  id                   String                @id @default(uuid()) @db.Uuid
  /// Human-readable running number shown in the ledger ("#1234").
  seq                  BigInt                @unique @default(autoincrement())
  /// Home entity: the bank account's entity, or the entity chosen for a manual journal.
  entityId             String                @map("entity_id") @db.Uuid
  date                 DateTime              @db.Date
  vendor               String?
  memo                 String?
  status               TransactionStatus     @default(DRAFT)
  kind                 TransactionKind       @default(BANK)
  bankAccountId        String?               @map("bank_account_id") @db.Uuid
  source               TransactionSource     @default(MANUAL)
  sourceFile           String?               @map("source_file")
  sourceRef            String?               @map("source_ref")
  sourceRef2           String?               @map("source_ref_2")
  filledInBy           String?               @map("filled_in_by")
  verifiedByOwner      Boolean               @default(false) @map("verified_by_owner")
  classificationSource ClassificationSource? @map("classification_source")
  aiConfidence         Decimal?              @map("ai_confidence") @db.Decimal(4, 3)
  flags                Json                  @default("[]")
  needsModelSplit      Boolean               @default(false) @map("needs_model_split")
  receiptExpectedCount Int                   @default(0) @map("receipt_expected_count")
  postedAt             DateTime?             @map("posted_at") @db.Timestamptz(6)
  postedById           String?               @map("posted_by_id") @db.Uuid
  voidedAt             DateTime?             @map("voided_at") @db.Timestamptz(6)
  voidedById           String?               @map("voided_by_id") @db.Uuid
  voidReason           String?               @map("void_reason")
  createdById          String?               @map("created_by_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedById          String?               @map("updated_by_id") @db.Uuid
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  entity      Entity            @relation(fields: [entityId], references: [id], onDelete: Restrict)
  bankAccount BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  lines       TransactionLine[]
  notes       Note[]

  @@index([entityId, date])
  @@index([date])
  @@index([status])
  @@index([bankAccountId])
  @@index([vendor])
  @@map("transactions")
}

/// One side of an entry. A line with superseded_at IS NULL is live. Lines of a posted transaction are never
/// changed or deleted: splits, unsplits, edits and bridge regeneration supersede the old lines and insert
/// new ones (docs/DECISIONS.md P0-21). Database rules: debit/credit non-negative and exactly one non-zero;
/// attribution (bank line → bank's entity; class → class's entity; General → home entity); split children
/// belong to a superseded parent of the same transaction and sum to it.
model TransactionLine {
  id                       String    @id @default(uuid()) @db.Uuid
  transactionId            String    @map("transaction_id") @db.Uuid
  lineNo                   Int       @map("line_no")
  accountId                String?   @map("account_id") @db.Uuid
  classId                  String?   @map("class_id") @db.Uuid
  /// The entity this line is attributed to (docs/DESIGN.md §3). Null only on incomplete drafts.
  entityId                 String?   @map("entity_id") @db.Uuid
  debitCents               BigInt    @default(0) @map("debit_cents")
  creditCents              BigInt    @default(0) @map("credit_cents")
  memo                     String?
  name                     String?
  isBridge                 Boolean   @default(false) @map("is_bridge")
  parentLineId             String?   @map("parent_line_id") @db.Uuid
  allocationModelVersionId String?   @map("allocation_model_version_id") @db.Uuid
  allocationTargetId       String?   @map("allocation_target_id") @db.Uuid
  supersededAt             DateTime? @map("superseded_at") @db.Timestamptz(6)
  supersededByAuditId      BigInt?   @map("superseded_by_audit_id")
  sourceRow                Int?      @map("source_row")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction            Transaction             @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account                Account?                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  class                  Class?                  @relation(fields: [classId], references: [id], onDelete: Restrict)
  entity                 Entity?                 @relation(fields: [entityId], references: [id], onDelete: Restrict)
  parentLine             TransactionLine?        @relation("line_parent", fields: [parentLineId], references: [id], onDelete: Restrict)
  childLines             TransactionLine[]       @relation("line_parent")
  allocationModelVersion AllocationModelVersion? @relation(fields: [allocationModelVersionId], references: [id], onDelete: Restrict)
  allocationTarget       AllocationTarget?       @relation(fields: [allocationTargetId], references: [id], onDelete: Restrict)

  @@unique([transactionId, lineNo])
  @@index([accountId])
  @@index([classId])
  @@index([entityId])
  @@index([parentLineId])
  @@map("transaction_lines")
}

enum NoteKind {
  SYSTEM
  USER
}

/// System notes (AI reasoning, matching results, model applications) are append-only — a trigger blocks
/// UPDATE and DELETE. A transaction has at most one user note (partial unique index), edited with an audit row.
model Note {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String?  @map("transaction_id") @db.Uuid
  receiptId     String?  @map("receipt_id") @db.Uuid
  kind          NoteKind
  body          String
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedById   String?  @map("updated_by_id") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([transactionId, kind, createdAt])
  @@map("notes")
}

/// The year-end gate. One row per item once it has been ticked or overridden; items with no row are open.
model TaxYearChecklistItem {
  id             String    @id @default(uuid()) @db.Uuid
  taxYearId      String    @map("tax_year_id") @db.Uuid
  itemKey        String    @map("item_key")
  doneAt         DateTime? @map("done_at") @db.Timestamptz(6)
  doneById       String?   @map("done_by_id") @db.Uuid
  overrideReason String?   @map("override_reason")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxYear TaxYear @relation(fields: [taxYearId], references: [id], onDelete: Cascade)

  @@unique([taxYearId, itemKey])
  @@map("tax_year_checklist")
}

/// A named set of filters / sort / columns for a data grid, private to the user who saved it.
model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  page      String
  name      String
  state     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, page, name])
  @@map("saved_views")
}

// ---------------------------------------------------------------------------
// Import runs (Phase 2) — what was imported, when, by whom, and the report
// ---------------------------------------------------------------------------

enum ImportRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// One row per run of the historical import (terminal command or Settings → Data). Never deleted by the
/// app role. `summary` holds the counts and the acceptance checks; `report_markdown` is the import report
/// the Settings → Data tab shows (the same text is written to docs/IMPORT_REPORT.md).
model ImportRun {
  id              String          @id @default(uuid()) @db.Uuid
  startedAt       DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?       @map("finished_at") @db.Timestamptz(6)
  status          ImportRunStatus @default(RUNNING)
  dryRun          Boolean         @default(false) @map("dry_run")
  trigger         String
  runById         String?         @map("run_by_id") @db.Uuid
  sources         Json
  summary         Json?
  allChecksPassed Boolean?        @map("all_checks_passed")
  reportMarkdown  String?         @map("report_markdown")
  error           String?

  @@index([startedAt])
  @@map("import_runs")
}

// ---------------------------------------------------------------------------
// Allocation models (docs/DESIGN.md §1 "Allocation models", §5) — Phase 2 stores the archived
// 2020–2024 worksheet models as read-only reference models; Phase 5 adds the builder, rules and
// applications on the same tables.
// ---------------------------------------------------------------------------

enum AllocationBasis {
  PERCENT
  VALUE
  ACRES
  MONTHS
  COUNT
}

/// One entity's recipe for splitting shared costs in one tax year. The "applied" state lives here
/// because versions are immutable.
model AllocationModel {
  id               String    @id @default(uuid()) @db.Uuid
  entityId         String    @map("entity_id") @db.Uuid
  taxYearId        String    @map("tax_year_id") @db.Uuid
  name             String
  description      String?
  /// True for the archived 2020–2024 worksheet models: documentation only, never applied.
  isReference      Boolean   @default(false) @map("is_reference")
  isActive         Boolean   @default(true) @map("is_active")
  /// Import idempotency key for reference models ("2024 Tax Worksheet:pct_all"); null for user-made models.
  sourceKey        String?   @unique @map("source_key")
  currentVersionId String?   @map("current_version_id") @db.Uuid
  appliedVersionId String?   @map("applied_version_id") @db.Uuid
  appliedAt        DateTime? @map("applied_at") @db.Timestamptz(6)
  appliedById      String?   @map("applied_by_id") @db.Uuid
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  entity   Entity                   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  taxYear  TaxYear                  @relation(fields: [taxYearId], references: [id], onDelete: Restrict)
  versions AllocationModelVersion[]

  @@unique([taxYearId, name])
  @@index([entityId])
  @@map("allocation_models")
}

/// Immutable once written (database trigger). One basis per version so shares are comparable;
/// `parameters` keeps the raw worksheet inputs of a reference model (values, acres, bill totals, notes).
model AllocationModelVersion {
  id                    String           @id @default(uuid()) @db.Uuid
  modelId               String           @map("model_id") @db.Uuid
  versionNo             Int              @map("version_no")
  basis                 AllocationBasis
  secondaryBasis        AllocationBasis? @map("secondary_basis")
  note                  String?
  diff                  Json?
  parameters            Json?
  revertedFromVersionId String?          @map("reverted_from_version_id") @db.Uuid
  createdById           String?          @map("created_by_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  model   AllocationModel    @relation(fields: [modelId], references: [id], onDelete: Restrict)
  targets AllocationTarget[]
  lines   TransactionLine[]

  @@unique([modelId, versionNo])
  @@map("allocation_model_versions")
}

/// One target of a version: a class, or the special Personal target (class null → posts to 3102, class
/// General). Database rules: per version Σ share_bp = 10,000 and exactly one remainder target.
model AllocationTarget {
  id                String   @id @default(uuid()) @db.Uuid
  versionId         String   @map("version_id") @db.Uuid
  classId           String?  @map("class_id") @db.Uuid
  isPersonal        Boolean  @default(false) @map("is_personal")
  /// The worksheet's own label for the target ("The Club House", "Our House").
  label             String
  weight            Decimal  @db.Decimal(18, 6)
  weight2           Decimal? @map("weight_2") @db.Decimal(18, 6)
  shareBp           Int      @map("share_bp")
  isRemainderTarget Boolean  @default(false) @map("is_remainder_target")
  sortOrder         Int      @default(0) @map("sort_order")

  version AllocationModelVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  class   Class?                 @relation(fields: [classId], references: [id], onDelete: Restrict)
  lines   TransactionLine[]

  @@index([versionId])
  @@index([classId])
  @@map("allocation_targets")
}
